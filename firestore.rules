rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- users/{uid} : profile ----------
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // ---------- users/{uid}/khatmas/{code} : "my khatmas" mirror ----------
      match /khatmas/{code} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // ---------- khatmas/{code} : group khatma room ----------
    match /khatmas/{code} {
      // Anyone signed in can open a room if they already know its code
      // (a direct get()), but browsing/listing all rooms is blocked.
      allow get: if request.auth != null;
      allow list: if false;

      allow create: if request.auth != null
                    && request.resource.data.ownerId == request.auth.uid;

      allow update, delete: if request.auth != null
                    && resource.data.ownerId == request.auth.uid;

      // ---------- khatmas/{code}/members/{uid} ----------
      match /members/{uid} {
        function isOwner() {
          return request.auth != null &&
            get(/databases/$(database)/documents/khatmas/$(code)).data.ownerId == request.auth.uid;
        }
        function isSelf() {
          return request.auth != null && request.auth.uid == uid;
        }
        function isMember() {
          return request.auth != null &&
            exists(/databases/$(database)/documents/khatmas/$(code)/members/$(request.auth.uid));
        }

        // Any member of the room (or the owner) can see the member list
        allow read: if isMember() || isOwner();

        // Joining: you can only ever create your own membership doc
        allow create: if isSelf();

        // Members may only touch their own "completed" flag;
        // the owner may only touch a member's "assignment" text.
        allow update: if (isSelf()
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['completed']))
                         || (isOwner()
                            && request.resource.data.diff(resource.data).affectedKeys()
                                 .hasOnly(['assignment']));

        // Leaving (self) or the owner removing/cascading a deletion
        allow delete: if isSelf() || isOwner();
      }
    }
  }
}
